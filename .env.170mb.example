# Example env for a low-RAM deployment of MicroFlow. Copy to .env / set
# as your host's env vars. Read LOWRAM.md first -- these are the
# tightest settings that still ran the full sample workflow correctly
# in testing, NOT a guarantee that the whole system fits in 170MB (it
# does not, once real ffmpeg/python3 child processes are counted --
# see LOWRAM.md).

DATABASE_URL=postgres://user:pass@host/db?sslmode=require
MICROFLOW_MASTER_KEY=changeme-generate-with-go-run-./cmd/server-genkey

# --- Go process memory tuning ---
MICROFLOW_HEAP_CEILING_MB=90
GOGC=30
# GOMEMLIMIT is derived from MICROFLOW_HEAP_CEILING_MB automatically
# (+30MB headroom) if not set explicitly here -- see
# configureGoRuntimeForLowRAM in cmd/server/main.go. Uncomment to pin
# it directly instead:
# GOMEMLIMIT=120MiB

# --- Concurrency (this deployment only ever runs ONE workflow) ---
MICROFLOW_MAX_CONCURRENT_EXECUTIONS=1
MICROFLOW_MAX_CONCURRENT_HEAVY=1
MICROFLOW_DB_MAX_CONNS=2

# --- Paths ---
MICROFLOW_SCRATCH_DIR=/tmp/microflow
MICROFLOW_FFMPEG_PATH=/usr/bin/ffmpeg
MICROFLOW_PYTHON_PATH=/usr/bin/python3
# Must point at the pure-Go cmd/edgetts binary, NOT pip's edge-tts --
# see LOWRAM.md and the Dockerfile header comment for why the plain
# PATH entry named `edge-tts` also has to be the Go binary, not just
# this env var.
MICROFLOW_EDGE_TTS_PATH=/usr/local/bin/edge-tts

# --- Workflow's own Code-node secrets (from My_workflow_14.json) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
YOUTUBE_DATA_API_KEY=
APP_REFERER_URL=
NOTIFY_WEBHOOK_URL=
